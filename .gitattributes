# Treat bundled third-party binaries/headers as vendored so they don't skew GitHub language stats.
resources/pdfium-win-x64/** linguist-vendored whitespace=cr-at-eol
resources/pdfium-linux-x64/** linguist-vendored
resources/icons/scalable/** linguist-vendored
docs/** linguist-vendored
# Preserve upstream whitespace verbatim in vendored source and license copies.
vendor/** linguist-vendored whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
vendor/unrar-sys/vendor/unrar/** whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
resources/*LICENSE* whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
